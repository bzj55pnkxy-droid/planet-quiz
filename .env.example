# Copy to .env to override. Every value below is the built-in default
# (development profile: Apple M2, 16 GB). Other hardware: see configs/.
# Changing EMBED_MODEL or a prefix requires re-running ingestion.
OLLAMA_BASE_URL=http://127.0.0.1:11434
CHAT_MODEL=gemma3:4b
EMBED_MODEL=nomic-embed-text
EMBED_DOC_PREFIX="search_document: "
EMBED_QUERY_PREFIX="search_query: "
SOURCES_DIR=data/sources
CHROMA_DIR=data/chroma
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
TEMPERATURE=0.2
