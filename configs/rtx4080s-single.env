# RTX 4080 Super (16 GB VRAM), ONE model in VRAM at a time.
# Each model gets the whole card, so both are the largest that fit alone.
# Cost: every request embeds the query, then swaps to the chat model, so
# expect a model reload on each question. Best when answer quality matters
# more than response time.
#
# Use:  cp configs/rtx4080s-single.env .env
#       ollama pull gemma4:12b-it-q8_0 && ollama pull qwen3-embedding:8b-q8_0
#       uv run python -m app.ingest
#
# Ollama SERVER settings (set where `ollama serve` runs, not read by the app):
#   OLLAMA_MAX_LOADED_MODELS=1   evict the loaded model before loading the other
#   OLLAMA_NUM_PARALLEL=1
#   OLLAMA_CONTEXT_LENGTH=8192   13 GB of weights leaves ~2 GB for context
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Gemma 4 12B, 8-bit: 13 GB. If Ollama reports CPU offload (`ollama ps`
# shows less than 100% GPU), fall back to gemma4:12b-it-qat (7.2 GB).
CHAT_MODEL=gemma4:12b-it-q8_0

# Qwen3 Embedding 8B, 8-bit: 8.0 GB, 4096-dimensional vectors.
# Queries take an instruction, documents are embedded as-is.
EMBED_MODEL=qwen3-embedding:8b-q8_0
EMBED_DOC_PREFIX=""
EMBED_QUERY_PREFIX="Instruct: Given a question about the solar system, retrieve passages that answer it\nQuery: "

# Separate index per embedding model: vectors from different models
# have different dimensions and are not comparable.
CHROMA_DIR=data/chroma-qwen3-embedding-8b
