# RTX 4080 Super (16 GB VRAM), chat and embedding model loaded TOGETHER.
# 7.2 GB + 4.3 GB of weights = 11.5 GB, leaving ~4 GB for context and the
# desktop. No model swapping, so this is the responsive profile for demos.
#
# Use:  cp configs/rtx4080s-concurrent.env .env
#       ollama pull gemma4:12b-it-qat && ollama pull qwen3-embedding:4b-q8_0
#       uv run python -m app.ingest
#
# Ollama SERVER settings (set where `ollama serve` runs, not read by the app):
#   OLLAMA_MAX_LOADED_MODELS=2   keep both models resident
#   OLLAMA_KEEP_ALIVE=30m        do not unload between questions
#   OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Gemma 4 12B, quantization-aware-trained 4-bit: 7.2 GB.
CHAT_MODEL=gemma4:12b-it-qat

# Qwen3 Embedding 4B, 8-bit: 4.3 GB, 2560-dimensional vectors.
# Queries take an instruction, documents are embedded as-is.
EMBED_MODEL=qwen3-embedding:4b-q8_0
EMBED_DOC_PREFIX=""
EMBED_QUERY_PREFIX="Instruct: Given a question about the solar system, retrieve passages that answer it\nQuery: "

# Separate index per embedding model: vectors from different models
# have different dimensions and are not comparable.
CHROMA_DIR=data/chroma-qwen3-embedding-4b
